# =============================================================
# Backend selection — switch between azure, local, and ngrok without code changes
# =============================================================
# Which backend is active. Allowed values: "azure" | "local" | "ngrok"
VITE_ACTIVE_BACKEND=azure

# Azure Cloud Backend
VITE_AZURE_API_URL=https://smartmarketbot-api-d3achkeqhdcbfudw.southeastasia-01.azurewebsites.net

# Local backend (Docker / dotnet run on this machine)
VITE_LOCAL_API_URL=http://localhost:5000

# Ngrok tunnel (URL changes every time you restart ngrok)
VITE_NGROK_API_URL=https://interiorly-pinnatisect-adalyn.ngrok-free.dev

# =============================================================
# Notes
# =============================================================
# - `VITE_ACTIVE_BACKEND` picks which of the URLs above is used.
# - To switch backends, change `VITE_ACTIVE_BACKEND` and restart `npm run dev`.
# - When pointing at ngrok, the Vite proxy automatically adds the
#   `ngrok-skip-browser-warning` header so the tunnel page is bypassed.
# - Optional: `VITE_API_BASE_URL` overrides all of the above if specified directly.