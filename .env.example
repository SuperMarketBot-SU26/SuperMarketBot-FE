# =============================================================
# Backend selection — switch between local and ngrok without code changes
# =============================================================
# Which backend is active. Allowed values: "local" | "ngrok"
VITE_ACTIVE_BACKEND=ngrok

# Local backend (Docker / dotnet run on this machine)
VITE_LOCAL_API_URL=http://localhost:5000

# Ngrok tunnel (URL changes every time you restart ngrok)
VITE_NGROK_API_URL=https://interiorly-pinnatisect-adalyn.ngrok-free.dev

# =============================================================
# Notes
# =============================================================
# - `VITE_ACTIVE_BACKEND` picks which of the two URLs above is used.
# - To switch backends, change `VITE_ACTIVE_BACKEND` and restart `npm run dev`.
# - When pointing at ngrok, the Vite proxy automatically adds the
#   `ngrok-skip-browser-warning` header so the tunnel page is bypassed.